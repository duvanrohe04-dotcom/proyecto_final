# Copia este archivo como .env y rellena los valores
SECRET_KEY=cambia-esto-por-una-clave-segura

# Para desarrollo local con SQLite:
# DATABASE_URL=sqlite:///taller.db

# Para produccion con PostgreSQL (Coolify / docker-compose):
DATABASE_URL=postgresql://postgres:postgres@db:5432/taller_db

# Variables individuales (fallback si DATABASE_URL no esta definida)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taller_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

FLASK_ENV=development
